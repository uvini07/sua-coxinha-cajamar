{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sua-coxinha-cajamar.vercel.app" }],
      "destination": "https://www.suacoxinhaloja.com.br/cajamar",
      "permanent": true
    },
    {
      "source": "/:caminho*",
      "has": [{ "type": "host", "value": "sua-coxinha-cajamar.vercel.app" }],
      "destination": "https://www.suacoxinhaloja.com.br/:caminho*",
      "permanent": true
    }
  ],
  "headers": [
    { "source": "/painel", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "rewrites": [
    { "source": "/((?!assets/|duelo|pacotes|favicon|apple-touch-icon|compartilhar).*)", "destination": "/" }
  ]
}
